{
  "name": "ohdsi-mcps",
  "version": "1.0.0",
  "description": "A collection of MCP server for OMOP users (ex. CDM specification, the book of ohdsi, forum, athena)",
  "type": "module",
  "bin": {
    "cdm-spec-server": "./src/cdm/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "cdm": "tsx src/cdm/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "repository": "github:Leko/ohdsi-mcps",
  "keywords": [
    "mcp",
    "mcp-server",
    "ohdsi",
    "omop",
    "cdm",
    "athena"
  ],
  "author": "Leko <leko.noor@gmail.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^4.3.6"
  }
}
